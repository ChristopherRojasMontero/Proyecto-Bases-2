# Copiar este archivo como ".env" y completar los valores.
# El archivo ".env" NUNCA se sube a Git (está en .gitignore).

# Conexión a SQL Server
DB_SERVER=localhost
DB_PORT=1433
# Opcional: nombre de instancia (ej. SQLEXPRESS). Si se usa, se ignora DB_PORT
# y debe estar activo el servicio "SQL Server Browser".
DB_INSTANCE=
DB_NAME=CineStream
DB_USER=cine_app
DB_PASSWORD=
DB_ENCRYPT=true
DB_TRUST_CERT=true

# Puerto de la API
PORT=3000

# Módulo 3: cada cuántas horas la API guarda una medición del tamaño de la base
# (historial de crecimiento). 0 = desactivado.
REGISTRO_ALMACENAMIENTO_HORAS=24
